# Names only. Real values live in Vercel and in git-ignored .env*.local files.
# Local dev: .env.development.local (Neon dev branch). Tests: .env.test.local (Neon test branch).

# Neon Postgres (pooled for the app, direct for migrations)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Google OAuth (localhost and production only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Magic-link email (Resend)
RESEND_API_KEY=
EMAIL_FROM=

# Cloudflare Turnstile (the site key is the only public variable)
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Header that carries the client IP for rate limits (Vercel: x-forwarded-for, Cloudflare: cf-connecting-ip)
AUTH_IP_HEADER=
